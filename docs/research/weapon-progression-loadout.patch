diff --git a/game/tools/balance/sim_loadout.gd b/game/tools/balance/sim_loadout.gd
new file mode 100644
--- /dev/null
+++ b/game/tools/balance/sim_loadout.gd
@@ -0,0 +1,33 @@
+class_name SimLoadout
+extends RefCounted
+## Research only (#1055): a permanent loadout laid over chosen players of a simulated night.
+## `--loadout=damage=1.1:reload=0.8` names the numbers, `--equipped=2,3` the player ids that carry them
+## (default: all). Keys: damage, melee, interval, reload, mag (multipliers); accuracy, head, dodge, uptime,
+## health (added).
+
+static var _by_player: Dictionary = {}
+
+
+static func parse(loadout: String, equipped: String, players: int) -> void:
+	_by_player = {}
+	if loadout.is_empty():
+		return
+	var numbers := {}
+	for pair in loadout.split(":"):
+		var parts := pair.split("=")
+		numbers[parts[0]] = float(parts[1])
+	var ids: Array = []
+	if equipped.is_empty():
+		for id in range(1, players + 1):
+			ids.append(id)
+	else:
+		for id in equipped.split(","):
+			ids.append(int(id))
+	for id in ids:
+		_by_player[id] = numbers
+
+
+static func v(player_id: int, key: String, default: float = 0.0) -> float:
+	if not _by_player.has(player_id):
+		return default
+	return float(_by_player[player_id].get(key, default))
