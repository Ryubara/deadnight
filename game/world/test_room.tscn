[gd_scene load_steps=12 format=3]

[ext_resource type="PackedScene" path="res://gameplay/player/player.tscn" id="1_player"]

[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;

// Greybox checker in world space, on whichever plane the face points along, so motion reads.
uniform vec4 color_a : source_color = vec4(0.62, 0.62, 0.64, 1.0);
uniform vec4 color_b : source_color = vec4(0.48, 0.48, 0.5, 1.0);
uniform float tile = 1.0;

varying vec3 world_pos;
varying vec3 world_normal;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	world_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 n = abs(world_normal);
	vec2 uv = n.y >= n.x && n.y >= n.z ? world_pos.xz : (n.x >= n.z ? world_pos.zy : world_pos.xy);
	vec2 cell = floor(uv / tile);
	float checker = mod(cell.x + cell.y, 2.0);
	ALBEDO = mix(color_a.rgb, color_b.rgb, checker);
	ROUGHNESS = 1.0;
}
"

