[gd_resource type="Resource" script_class="SoundBank" format=3]

[ext_resource type="Script" path="res://core/audio/sound_bank.gd" id="1_bank"]
[ext_resource type="Script" path="res://core/audio/sound_def.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_round_start"]
resource_name = "round_start"
script = ExtResource("2_def")
id = &"round_start"
path_format = "res://assets/audio/stings/round_start_%d.ogg"
variants = 1
bus = &"Music"
loop = false
volume_db = -3.0
pitch_semitones = 0.0
group = &"sting"
priority = 95
cooldown = 0.0
max_distance = 50.0
unit_size = 8.0
near_cap_db = inf
rear_cue = false
duck_db = -9.0
duck_hold = 1.6

[sub_resource type="Resource" id="Resource_round_end"]
resource_name = "round_end"
script = ExtResource("2_def")
id = &"round_end"
path_format = "res://assets/audio/stings/round_end_%d.ogg"
variants = 1
bus = &"Music"
loop = false
volume_db = -5.0
pitch_semitones = 0.0
group = &"sting"
priority = 95
cooldown = 0.0
max_distance = 50.0
unit_size = 8.0
near_cap_db = inf
rear_cue = false
duck_db = -5.0
duck_hold = 0.8

[sub_resource type="Resource" id="Resource_special_round"]
resource_name = "special_round"
script = ExtResource("2_def")
id = &"special_round"
path_format = "res://assets/audio/stings/special_round_%d.ogg"
variants = 1
bus = &"Music"
loop = false
volume_db = -3.0
pitch_semitones = 0.0
group = &"sting"
priority = 98
cooldown = 0.0
max_distance = 50.0
unit_size = 8.0
near_cap_db = inf
rear_cue = false
duck_db = -9.0
duck_hold = 2.2

[resource]
script = ExtResource("1_bank")
label = "Round stings that duck the effects"
sounds = Array[ExtResource("2_def")]([SubResource("Resource_round_start"), SubResource("Resource_round_end"), SubResource("Resource_special_round")])
