[gd_resource type="Resource" script_class="SoundBank" format=3]

[ext_resource type="Script" path="res://core/audio/sound_bank.gd" id="1_bank"]
[ext_resource type="Script" path="res://core/audio/sound_def.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_points_tick"]
resource_name = "points_tick"
script = ExtResource("2_def")
id = &"points_tick"
path_format = "res://assets/audio/ui/points_tick_%d.ogg"
variants = 1
bus = &"UI"
loop = false
volume_db = 0.0
pitch_semitones = 0.4
group = &"points"
priority = 30
cooldown = 0.03
max_distance = 50.0
unit_size = 8.0
near_cap_db = inf
rear_cue = false
duck_db = 0.0
duck_hold = 0.0

[sub_resource type="Resource" id="Resource_points_kill"]
resource_name = "points_kill"
script = ExtResource("2_def")
id = &"points_kill"
path_format = "res://assets/audio/ui/points_kill_%d.ogg"
variants = 1
bus = &"UI"
loop = false
volume_db = 0.0
pitch_semitones = 0.3
group = &"points"
priority = 35
cooldown = 0.05
max_distance = 50.0
unit_size = 8.0
near_cap_db = inf
rear_cue = false
duck_db = 0.0
duck_hold = 0.0

[sub_resource type="Resource" id="Resource_challenge_tick"]
resource_name = "challenge_tick"
script = ExtResource("2_def")
id = &"challenge_tick"
path_format = "res://assets/audio/ui/challenge_tick_%d.ogg"
variants = 1
bus = &"UI"
loop = false
