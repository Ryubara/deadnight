[resource]
script = ExtResource("1_bank")
label = "The night's HUD cues: the points and the challenge prompt (the menu's are in ui_menu.tres)"
sounds = Array[ExtResource("2_def")]([SubResource("Resource_challenge_tick"), SubResource("Resource_challenge_done"), SubResource("Resource_points_tick"), SubResource("Resource_points_kill")])
