max_distance = 50.0
unit_size = 8.0
near_cap_db = inf
rear_cue = false
duck_db = 0.0
duck_hold = 0.0

[sub_resource type="Resource" id="Resource_challenge_done"]
resource_name = "challenge_done"
script = ExtResource("2_def")
id = &"challenge_done"
path_format = "res://assets/audio/ui/challenge_done_%d.ogg"
variants = 1
bus = &"UI"
loop = false
volume_db = 0.0
pitch_semitones = 0.0
group = &"challenge"
priority = 60
