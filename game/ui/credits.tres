[gd_resource type="Resource" script_class="CreditsList" format=3]

[ext_resource type="Script" path="res://ui/credits_list.gd" id="1"]

[resource]
script = ExtResource("1")
lines = PackedStringArray("# Made by", "Ryubara - design and direction", "Built by agents on the GDStudio kit", "# Art", "Quaternius - Soldier and props (Toon Shooter Game Kit) and Zombie models, CC0", "# Sound", "Sound effects and the soldier's voice generated with ElevenLabs", "# Typefaces", "Bungee Inline - David Jonathan Ross, SIL OFL 1.1", "Barlow Condensed - Jeremy Tribby, SIL OFL 1.1", "Open Sans (the engine's fallback font) - Open Sans Project Authors, SIL OFL 1.1", "# Made with", "Godot Engine - MIT licence", "GdUnit4 - MIT licence", "# Thanks", "Everyone who parked for the late show")
